# Obsidian per-device state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# graphify build cache (regenerate with /graphify)
graphify-out/cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python (fire-drill)
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
.env

# attack turn files stay local (no payloads in the repo)
fire-drill/turns/

# drill records hold the attacker turns; commit-reveal decides what is published
fire-drill/records/

# commit-reveal: the commitment is public, the salts and the reveal (which
# holds the drills themselves) are published only when you choose to
fire-drill/commitments/*.salts.json
fire-drill/commitments/*.reveal.json
