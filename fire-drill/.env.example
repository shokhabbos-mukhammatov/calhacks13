# Copy to .env and fill in. .env is gitignored; never commit real values.
# Every sponsor sits behind a port with a fallback adapter, so a blank key
# only drops that adapter, never the core demo.

# --- Anthropic: Victim Agent, drill driver, Claude Code remediation ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Apify: corpus, runner and verify Actors ---
# https://console.apify.com/settings/integrations
APIFY_TOKEN=

# --- Capital One Nessie: PaymentRail ---
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

# --- CRS Credit API: BusinessCheck (sandbox only, every record is fake) ---
# Invite from calhacks.crscreditapi.com. Quote the password if it contains #.
# Log in once and reuse the token: repeated failed logins lock the account.
CRS_USERNAME=
CRS_PASSWORD=
CRS_BASE_URL=https://api-sandbox.stitchcredit.com/api

# --- Cartesia: voice Channel (Line agent) ---
# Key: https://play.cartesia.ai/keys  Agent: https://play.cartesia.ai/agents
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
CARTESIA_AGENT_ID=

# --- Elastic: TraceSink, Agent Builder on a Serverless project ---
# Both URLs are on the project's page in cloud.elastic.co. The API key needs
# Kibana privileges for Agent Builder; its MCP endpoint is
# $KIBANA_URL/api/agent_builder/mcp.
ELASTICSEARCH_URL=
KIBANA_URL=
ELASTIC_API_KEY=

# --- Factory: Droid SDK, the second CodeAgent adapter ---
# app.factory.ai -> Settings -> API Keys (fk-...)
FACTORY_API_KEY=
