# Copy to .env (gitignored) and fill in. Never commit .env.

# Anthropic: the AP agent, drill driver and Claude Code auto-fix
ANTHROPIC_API_KEY=

# Apify: attack-feed, fire-drill and vendor-verify Actors
APIFY_TOKEN=

# CRS sandbox (calhacks.crscreditapi.com): vendor-verify contact checks
# (Fraud Finder on the requester's email/phone, reverse lookup of the callback number)
CRS_USERNAME=
CRS_PASSWORD=
CRS_BASE_URL=https://api-sandbox.stitchcredit.com/api

# Capital One Nessie: mirrors approved payments as sandbox transfers
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

# Cartesia: voice channel (Managed Agents, API version 2026-08-14)
CARTESIA_API_KEY=
CARTESIA_AGENT_ID=           # from play.cartesia.ai/agents
CARTESIA_PHONE_NUMBER_ID=    # "id" returned when you provision a number (used as from_number_id)
CARTESIA_PHONE_NUMBER=       # the E.164 number itself, for display and inbound calls

# Factory: Droid as the alternative auto-fix adapter
FACTORY_API_KEY=

# Elastic Serverless: drill traces + Agent Builder
ELASTIC_URL=
ELASTIC_API_KEY=
