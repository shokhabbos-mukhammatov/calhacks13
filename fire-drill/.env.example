# Copy to .env (gitignored) and fill in. Never commit .env.

# Anthropic: the AP agent, drill driver and Claude Code auto-fix
ANTHROPIC_API_KEY=

# Apify: attack-feed, fire-drill and vendor-verify Actors
APIFY_TOKEN=

# CRS sandbox (calhacks.crscreditapi.com): vendor-verify business + sanctions checks
CRS_USERNAME=
CRS_PASSWORD=

# Capital One Nessie: mirrors approved payments as sandbox transfers
NESSIE_API_KEY=
NESSIE_BASE_URL=

# Cartesia: voice channel
CARTESIA_API_KEY=
CARTESIA_PHONE_NUMBER=

# Factory: Droid as the alternative auto-fix adapter
FACTORY_API_KEY=

# Elastic Serverless: drill traces + Agent Builder
ELASTIC_URL=
ELASTIC_API_KEY=
